# Supabaseプロジェクトの Settings > API から取得して .env にコピーする。
# 未設定でもアプリは起動する(ローカル/IndexedDBモードのみで動作し、
# 公開・ログイン等クラウド機能だけが使えない状態になる)。
# 詳しい手順は docs/setup-supabase.md を参照。

SUPABASE_URL=
SUPABASE_KEY=

# Anthropic API key(https://console.anthropic.com/ で取得)。
# 未設定でも「台本を読み込む」機能自体は動く(簡易ルールベース解析に
# フォールバックする)。設定するとAIによる高精度な台本解析が有効になる。
ANTHROPIC_API_KEY=
